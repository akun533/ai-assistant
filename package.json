{
  "name": "@ai-assistant/core",
  "version": "1.0.0",
  "description": "通用 AI 助手服务，支持多 AI 服务、流式响应和 MCP 工具",
  "main": "dist/service/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/service/index.ts",
    "start:build": "tsc && node dist/service/index.js",
    "build:backend": "node build.cjs",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write src/**/*.{ts,js,json,md}",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "AI",
    "assistant",
    "MCP",
    "stream",
    "chat",
    "openai",
    "deepseek",
    "qwen",
    "zhipu"
  ],
  "author": "xaboy",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.0.0",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-json-patch": "^3.1.1",
    "fast-png": "^8.0.0",
    "jsondiffpatch": "^0.7.3",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "onnxruntime-node": "^1.22.0",
    "paddleocr": "^1.0.7",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0"
  }
}
